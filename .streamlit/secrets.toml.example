# Chép file này thành secrets.toml (trên máy) hoặc dán vào ô Secrets của Streamlit Cloud.
# KHÔNG đưa secrets.toml lên GitHub, không gửi cho ai.
[luu_tru]
kieu = "sheets"
sheet_id_danh_muc = "DÁN_ID_FILE_APP_KHO_DANH_MUC"            # phần giữa /d/ và /edit trong đường link của file
# Dữ liệu phiếu TÁCH RIÊNG TỪNG NHÀ MÁY (khuyến nghị): mỗi nhà máy một file
sheet_id_nm1 = "DÁN_ID_FILE_APP_KHO_PHAT_SINH_NM1_2026"
sheet_id_nm2 = "DÁN_ID_FILE_APP_KHO_PHAT_SINH_NM2_2026"
# (cách cũ vẫn dùng được: bỏ 2 dòng nm1/nm2 và thay bằng  sheet_id_phat_sinh = "..."  cho 1 file phát sinh chung;
#  hoặc chỉ 1 file cho tất cả:  sheet_id = "...")

[luu_tru.credentials]
# Dán nội dung file JSON của tài khoản dịch vụ, mỗi trường một dòng:
type = "service_account"
project_id = "..."
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "...@....iam.gserviceaccount.com"
client_id = "..."
token_uri = "https://oauth2.googleapis.com/token"
